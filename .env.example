# ==============================================================================
# ФСП ХАКАТОН 2026: КОНФИГУРАЦИЯ СЕРВЕРНОГО ОКРУЖЕНИЯ (.env)
# ==============================================================================
# Данный файл содержит шаблон параметров запуска платформы.
# Скопируйте этот файл в .env: `cp .env.example .env` (или `copy .env.example .env` на Windows)

# --- Приложение FastAPI ---
PROJECT_NAME="Цифровая платформа ИТ-вакансий ФСП"
API_V1_STR="/api/v1"
ENVIRONMENT="development"  # development | production | test
DEBUG=True
SECRET_KEY="fsp_phaeton_hackathon_super_secret_jwt_key_change_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- База данных PostgreSQL (с pgvector и pg_trgm) ---
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="fsp_password_2026"
POSTGRES_DB="fsp_platform_db"
DATABASE_URL="postgresql+asyncpg://postgres:fsp_password_2026@localhost:5432/fsp_platform_db"

# --- Redis & Очереди задач ---
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"
# Режим асинхронности: 'inline' (быстрый запуск в одном процессе без отдельного воркера)
# либо 'worker' (выделенный процесс воркера)
ASYNC_MODE="inline"

# --- Параметры алгоритма подбора и скоринга ---
# Веса компонентов (сумма = 1.0)
WEIGHT_STACK=0.30
WEIGHT_GRADE=0.25
WEIGHT_SALARY=0.20
WEIGHT_FRESHNESS=0.10
WEIGHT_FSP=0.15

# Порог стандартной ошибки для остановки CAT-теста (SE <= 0.35)
CAT_SE_THRESHOLD=0.35
CAT_MIN_QUESTIONS=8
CAT_MAX_QUESTIONS=15

# --- Кулдаун повторной сдачи тестирования ---
# В днях для продакшена (по ТЗ: 90 дней), для демо-режима хакатона можно ставить 0
RETEST_COOLDOWN_DAYS=0

# --- Настройки почтового сервера (Mailpit для локальной разработки) ---
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="noreply@fsp-it.ru"
EMAILS_FROM_NAME="Платформа ФСП"

# --- Провайдер LLM (Опционально: Gigachat / YandexGPT / OpenAI / Mock) ---
# Для работы жюри без внешних API-ключей по умолчанию используется 'mock'
LLM_PROVIDER="mock"
LLM_API_KEY=""

# --- Провайдер данных ФСП (Mock / Keycloak) ---
FSP_PROVIDER="mock"
KEYCLOAK_URL="http://localhost:8080"
KEYCLOAK_REALM="fsp"
KEYCLOAK_CLIENT_ID="fsp-platform"
